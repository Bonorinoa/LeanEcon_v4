{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanecon.org/schemas/economic-interpretation/1.0.0",
  "title": "EconomicInterpretation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim", "context", "objects", "assumptions", "conclusion", "ambiguities", "provenance", "confidence", "review", "data_classification"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "claim": {"type": "object", "required": ["canonical_text", "source_text"], "additionalProperties": false, "properties": {"canonical_text": {"type": "string", "minLength": 1}, "source_text": {"type": "string", "minLength": 1}}},
    "context": {"type": "object", "required": ["domain_tags", "definitions", "ontology_refs"], "additionalProperties": false, "properties": {"domain_tags": {"type": "array", "items": {"type": "string"}}, "definitions": {"type": "array", "items": {"type": "object"}}, "ontology_refs": {"type": "array", "items": {"type": "string"}}}},
    "objects": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "role"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "role": {"type": "string"}}}},
    "assumptions": {"type": "object", "required": ["proposed", "accepted"], "additionalProperties": false, "properties": {"proposed": {"type": "array", "items": {"type": "string"}}, "accepted": {"type": "array", "items": {"type": "string"}}}},
    "quantifiers": {"type": "array", "items": {"type": "string"}},
    "conclusion": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}, "solution_or_equilibrium_concept": {"type": ["string", "null"]}}},
    "ambiguities": {"type": "array", "items": {"type": "object", "required": ["issue", "alternatives"], "properties": {"issue": {"type": "string"}, "alternatives": {"type": "array", "items": {"type": "string"}}}}},
    "none_noted": {"type": "boolean", "description": "Draft-schema exercise (Gate 5 A3, CTO-approved 2026-08-06): true when no ambiguity was identified; requires reviewer acknowledgement in review before APPROVED."},
    "provenance": {"type": "object", "required": ["source_span", "mapping_method"], "properties": {"source_span": {"type": "string"}, "mapping_method": {"type": "string"}, "references": {"type": "array", "items": {"type": "string"}}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "degradation_flags": {"type": "array", "items": {"type": "string"}},
    "review": {"type": "object", "required": ["decision", "reviewer", "event_ref"], "properties": {"decision": {"enum": ["PENDING", "APPROVED", "REJECTED"]}, "reviewer": {"type": ["string", "null"], "description": "Draft-schema exercise (Gate 5 A3, CTO-approved 2026-08-06): null while PENDING; set by the reviewer approval event."}, "notes": {"type": "string"}, "event_ref": {"type": ["string", "null"], "description": "Draft-schema exercise (Gate 5 A3, CTO-approved 2026-08-06): null while PENDING; set by the reviewer approval event."}, "acknowledges_none_noted": {"type": "boolean"}}},
    "data_classification": {"enum": ["PUBLIC", "PROJECT", "RESTRICTED"]}
  }
}
